---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada — Estudio Jurídico">
  <section class="max-w-3xl mx-auto px-6 py-32 text-center">
    <p class="text-6xl md:text-8xl font-serif font-bold text-accent mb-4">404</p>
    <h1 class="text-2xl md:text-3xl font-serif font-bold mb-4">
      No encontramos lo que buscaba
    </h1>
    <p class="text-secondary mb-8">
      Es posible que la dirección sea incorrecta o que la página haya sido movida.
    </p>
    <a href="/" class="btn-gold">Volver al inicio</a>
  </section>
</Layout>
