---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada — Abogada Polastri">
  <section class="max-w-3xl mx-auto px-6 py-32 text-center">
    <p class="text-6xl md:text-8xl font-display font-semibold text-brand-500 mb-4">404</p>
    <h1 class="text-2xl md:text-3xl font-display font-semibold mb-4">
      No encontramos lo que buscaba
    </h1>
    <p class="text-ink-soft mb-8">
      Es posible que la dirección sea incorrecta o que la página haya sido movida.
    </p>
    <a href="/" class="btn-primary">Volver al inicio</a>
  </section>
</Layout>
