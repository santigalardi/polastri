---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getWhatsAppLink } from '../../utils/whatsapp';

export async function getStaticPaths() {
  const publicaciones = await getCollection('publicaciones', (p) => !p.data.borrador);
  return publicaciones.map((p) => ({ params: { slug: p.id }, props: { p } }));
}

const { p } = Astro.props;
const { Content } = await render(p);

const fmtFecha = (d: Date) =>
  d.toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' });

const consultaLink = getWhatsAppLink(
  `Hola María Laura, leí su publicación "${p.data.titulo}" y quería hacerle una consulta.`
);
---

<Layout title={`${p.data.titulo} — Abogada Polastri`} description={p.data.resumen}>
  <article class="bg-cream">
    <div class="max-w-3xl mx-auto px-5 sm:px-6 pt-12 sm:pt-16 md:pt-20 pb-14 sm:pb-20">
      <!-- Volver al blog -->
      <a href="/publicaciones/" class="inline-flex items-center gap-2 text-sm text-ink-muted hover:text-brand-600 transition-colors mb-8">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Publicaciones
      </a>

      <!-- Encabezado -->
      <time class="block text-sm font-display uppercase tracking-[0.16em] text-mauve-400 mb-4" datetime={p.data.fecha.toISOString()}>
        {fmtFecha(p.data.fecha)}
      </time>
      <h1 class="text-3xl md:text-4xl font-display font-semibold text-ink leading-tight mb-5 text-balance">
        {p.data.titulo}
      </h1>
      <div class="flex flex-wrap items-center gap-3 mb-2">
        <span class="inline-block text-[0.7rem] font-display font-medium uppercase tracking-[0.12em] text-brand-600 bg-brand-50 rounded-full px-3 py-1">
          {p.data.categoria}
        </span>
        <span class="text-sm text-ink-muted">por {p.data.autor}</span>
      </div>
      {p.data.fuente && (
        <p class="text-sm text-ink-muted uppercase tracking-wide mt-3">{p.data.fuente}</p>
      )}

      <span class="block w-full h-px bg-line my-8"></span>

      {p.data.portada && (
        <img
          src={p.data.portada}
          alt={p.data.titulo}
          class="w-full rounded-[var(--radius-card)] shadow-card mb-10 object-cover"
          loading="lazy"
        />
      )}

      <!-- Cuerpo del artículo -->
      <div class="prose-nota">
        <Content />
      </div>

      <!-- Seguir leyendo: enlace al PDF (modelo Beccar Varela) -->
      {p.data.pdf && (
        <div class="mt-10">
          <p class="font-display italic text-ink-soft mb-3">Seguir leyendo:</p>
          <a
            href={p.data.pdf}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 link-underline font-medium"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
            {p.data.titulo} (PDF)
          </a>
        </div>
      )}

      <!-- CTA a WhatsApp -->
      <div class="mt-12 sm:mt-16 rounded-[var(--radius-card)] bg-sand-50 border border-line p-6 sm:p-8 text-center">
        <p class="font-display text-lg sm:text-xl font-semibold text-ink mb-2">
          ¿Tiene una consulta sobre este tema?
        </p>
        <p class="text-ink-soft mb-5">Escríbame por WhatsApp y conversamos su caso.</p>
        <a href={consultaLink} target="_blank" rel="noopener noreferrer" class="btn-primary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.149-.174.198-.298.298-.496.099-.198.05-.372-.025-.521-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          Consultar por WhatsApp
        </a>
      </div>
    </div>
  </article>
</Layout>

<style>
  /* Tipografía del cuerpo de las notas — coherente con el sistema de diseño. */
  .prose-nota :global(h2) {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.25;
  }
  .prose-nota :global(h3) {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .prose-nota :global(p) {
    color: var(--color-ink-soft);
    line-height: 1.8;
    margin-bottom: 1.1rem;
  }
  .prose-nota :global(ul),
  .prose-nota :global(ol) {
    color: var(--color-ink-soft);
    line-height: 1.8;
    margin: 0 0 1.1rem 1.25rem;
    list-style: revert;
  }
  .prose-nota :global(li) {
    margin-bottom: 0.4rem;
  }
  .prose-nota :global(a) {
    color: var(--color-brand-500);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-nota :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
  .prose-nota :global(blockquote) {
    border-left: 3px solid var(--color-sand-300);
    padding-left: 1rem;
    font-style: italic;
    color: var(--color-ink-soft);
    margin: 1.5rem 0;
  }
</style>
