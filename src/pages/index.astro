---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Areas from '../components/sections/Areas.astro';
import Sucesiones from '../components/sections/Sucesiones.astro';
import SobreMi from '../components/sections/SobreMi.astro';
import ComoTrabajo from '../components/sections/ComoTrabajo.astro';
import Modalidad from '../components/sections/Modalidad.astro';
import Faq from '../components/sections/Faq.astro';
import Contacto from '../components/sections/Contacto.astro';
import { site } from '../data/site';
---

<Layout
  title={`${site.nombre} — Sucesiones y Derecho de Familia | Abogada ${site.abogada}`}
  description="Estudio jurídico especializado en sucesiones y derecho de familia. Atención presencial y online en Tres de Febrero y Tigre."
>
  <Hero />
  <Areas />
  <Sucesiones />
  <SobreMi />
  <ComoTrabajo />
  <Modalidad />
  <Faq />
  <Contacto />
</Layout>

<script>
  // Animación de entrada: revela los elementos [data-reveal] al hacer scroll.
  const items = document.querySelectorAll('[data-reveal]');

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    items.forEach((item) => observer.observe(item));
  } else {
    items.forEach((item) => item.classList.add('is-visible'));
  }
</script>
