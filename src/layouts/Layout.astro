---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import SeoSchema from '../components/SeoSchema.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /* Inserta el JSON-LD (LegalService + FAQPage). Solo en la home. */
  schema?: boolean;
}

const {
  title = `${site.nombre} — Abogada ${site.abogada}`,
  description = site.descripcion,
  schema = false,
} = Astro.props;

const siteBase = Astro.site ?? new URL(`https://${site.dominio}`);
const ogImage = new URL('/og-image.png', siteBase).href;
const canonical = new URL(Astro.url.pathname, siteBase).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Favicons (?v= fuerza a los navegadores a refrescar la caché) -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#973131" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.abogada} — Abogada`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap"
    />
    <title>{title}</title>
    {schema && <SeoSchema />}
  </head>
  <body class="flex flex-col min-h-screen">
    <NavBar />
    <main class="grow">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
  </body>
</html>
