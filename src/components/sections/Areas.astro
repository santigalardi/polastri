---
/*
  Áreas de práctica. Según las notas de la reunión, el estudio cubre cuatro
  áreas, pero se da énfasis a Sucesiones y Derecho de Familia. Las dos
  destacadas ocupan tarjetas grandes; las otras dos, tarjetas secundarias.
*/

/* Iconos por área — trazo lineal, coherentes entre sí (estilo Lucide). */
const iconos = {
  // Documento / legado — sucesiones
  sucesiones:
    '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h8"/><path d="M8 9h2"/>',
  // Personas / familia
  familia:
    '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  // Inmueble
  inmobiliario:
    '<path d="M3 9.5 12 3l9 6.5"/><path d="M5 10v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V10"/><path d="M9 21v-6h6v6"/>',
  // Balanza / derechos laborales
  laboral:
    '<path d="M12 3v18"/><path d="M5 21h14"/><path d="m3 8 4-4 4 4"/><path d="m13 8 4-4 4 4"/><path d="M7 4c0 4-2 6-4 6"/><path d="M7 4c0 4 2 6 4 6"/><path d="M17 4c0 4-2 6-4 6"/><path d="M17 4c0 4 2 6 4 6"/>',
};

const destacadas = [
  {
    titulo: 'Sucesiones',
    icono: iconos.sucesiones,
    descripcion:
      'Tramitación completa de la sucesión para que los bienes lleguen a quienes corresponde. ' +
      'Acompañamiento en cada etapa del proceso, con la posibilidad de financiar los gastos.',
    detalle: 'Ver propuesta de financiación',
    ancla: '#sucesiones',
  },
  {
    titulo: 'Derecho de Familia',
    icono: iconos.familia,
    descripcion:
      'Divorcios con liquidación de bienes y cuotas alimentarias. ' +
      'Foco en la negociación para alcanzar acuerdos claros y evitar conflictos prolongados.',
    detalle: null,
    ancla: '#contacto',
  },
];

const complementarias = [
  {
    titulo: 'Derecho Inmobiliario',
    icono: iconos.inmobiliario,
    descripcion:
      'Asesoramiento en operaciones y conflictos vinculados a propiedades.',
  },
  {
    titulo: 'Despidos y Derecho Laboral',
    icono: iconos.laboral,
    descripcion:
      'Defensa de los derechos del trabajador en situaciones de despido.',
  },
];
---

<section id="areas" class="bg-cream scroll-mt-20">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 py-14 sm:py-20 md:py-24">
    <div class="max-w-2xl mb-12" data-reveal>
      <p class="eyebrow mb-3">Áreas de práctica</p>
      <h2 class="text-3xl md:text-4xl font-display font-semibold mb-4">
        En qué puedo ayudarte
      </h2>
      <span class="rule mb-5"></span>
      <p class="text-ink-soft leading-relaxed">
        El estudio trabaja principalmente en dos áreas, donde concentra su
        experiencia y dedicación.
      </p>
    </div>

    <!-- Áreas destacadas -->
    <div class="grid md:grid-cols-2 gap-6 mb-6">
      {destacadas.map((area) => (
        <article class="card p-7 sm:p-8 flex flex-col" data-reveal>
          <div class="w-12 h-12 rounded-[var(--radius-card)] bg-brand-50 flex items-center justify-center mb-5">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand-500)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={area.icono}></svg>
          </div>
          <h3 class="text-2xl font-display font-semibold text-ink mb-3">{area.titulo}</h3>
          <p class="text-ink-soft leading-relaxed grow">{area.descripcion}</p>
          {area.detalle && (
            <a href={area.ancla} class="link-underline mt-5 inline-block text-sm font-medium">
              {area.detalle} →
            </a>
          )}
        </article>
      ))}
    </div>

    <!-- Áreas complementarias -->
    <div class="grid sm:grid-cols-2 gap-6">
      {complementarias.map((area) => (
        <article class="flex items-start gap-4 rounded-[var(--radius-card)] border border-line bg-sand-50 p-6" data-reveal>
          <div class="w-10 h-10 shrink-0 rounded-[var(--radius-card)] bg-sand-100 flex items-center justify-center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-mauve-400)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={area.icono}></svg>
          </div>
          <div>
            <h3 class="text-lg font-display font-semibold text-ink mb-1.5">{area.titulo}</h3>
            <p class="text-sm text-ink-soft leading-relaxed">{area.descripcion}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
