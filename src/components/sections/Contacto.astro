---
/*
  Sección de contacto. Es el objetivo central del sitio (definido en la
  reunión): generar consultas por WhatsApp. Se ofrecen accesos directos con
  el mensaje pre-cargado según el motivo de la consulta.
*/
import { getWhatsAppLink } from '../../utils/whatsapp';
import { redes, site } from '../../data/site';

const general = getWhatsAppLink();
const motivos = [
  {
    label: 'Sucesiones',
    msg: 'Hola María Laura, quisiera hacer una consulta sobre una sucesión.',
  },
  {
    label: 'Divorcio o cuota alimentaria',
    msg: 'Hola María Laura, quisiera hacer una consulta sobre derecho de familia.',
  },
  {
    label: 'Otra consulta',
    msg: 'Hola María Laura, me gustaría hacerle una consulta.',
  },
];
---

<section id="contacto" class="bg-brand-700 text-cream scroll-mt-20 overflow-hidden">
  <div class="relative max-w-4xl mx-auto px-5 sm:px-6 py-14 sm:py-20 md:py-24 text-center">
    <p class="eyebrow text-sand-200 mb-3" data-reveal>Contacto</p>
    <h2 class="text-[1.8rem] sm:text-3xl md:text-4xl font-display font-semibold text-cream mb-4" data-reveal>
      Cuénteme su caso
    </h2>
    <p class="text-sand-100/85 leading-relaxed max-w-xl mx-auto mb-10" data-reveal>
      El primer paso es conversar. Escríbame por WhatsApp con una breve
      descripción de su situación y le respondo para coordinar cómo seguimos.
    </p>

    <!-- Accesos directos por motivo -->
    <div class="flex flex-wrap justify-center gap-3 mb-10" data-reveal>
      {motivos.map((m) => (
        <a
          href={getWhatsAppLink(m.msg)}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full border border-cream/30 px-5 py-2.5 text-sm font-display text-cream hover:bg-cream/10 transition-colors"
        >
          {m.label}
        </a>
      ))}
    </div>

    <a href={general} target="_blank" rel="noopener noreferrer" class="btn-whatsapp" data-reveal>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
      </svg>
      Escribir por WhatsApp
    </a>

    <!-- Redes -->
    <div class="mt-12 pt-8 border-t border-cream/15" data-reveal>
      <p class="text-sm text-sand-100/70 mb-4">También puede seguir el estudio en redes</p>
      <div class="flex justify-center gap-4">
        <a
          href={redes.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="w-11 h-11 rounded-full border border-cream/25 flex items-center justify-center text-cream hover:bg-cream/10 transition-colors"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5"/>
            <circle cx="12" cy="12" r="4"/>
            <line x1="17.5" y1="6.5" x2="17.5" y2="6.5"/>
          </svg>
        </a>
        <a
          href={redes.facebook}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="w-11 h-11 rounded-full border border-cream/25 flex items-center justify-center text-cream hover:bg-cream/10 transition-colors"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07c0 6.02 4.39 11.01 10.13 11.93v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.8-4.69 4.54-4.69 1.31 0 2.69.24 2.69.24v2.97h-1.52c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8v8.44C19.61 23.08 24 18.09 24 12.07Z"/>
          </svg>
        </a>
        <a
          href={redes.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="w-11 h-11 rounded-full border border-cream/25 flex items-center justify-center text-cream hover:bg-cream/10 transition-colors"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM0 8h5v16H0zM7.98 8h4.79v2.19h.07c.67-1.27 2.3-2.6 4.73-2.6 5.06 0 6 3.33 6 7.66V24h-5v-7.6c0-1.81-.03-4.14-2.52-4.14-2.53 0-2.92 1.97-2.92 4v7.74h-5z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
