---
/*
  Preguntas frecuentes. Sección acordada en la reunión. El contenido vive en
  src/data/faqs.ts (fuente única, compartida con el schema FAQPage).
*/
import { faqs } from '../../data/faqs';
---

<section id="faq" class="bg-cream scroll-mt-20">
  <div class="max-w-3xl mx-auto px-5 sm:px-6 pt-10 sm:pt-12 md:pt-14 pb-14 sm:pb-20 md:pb-24">
    <div class="mb-8 sm:mb-12 text-center" data-reveal>
      <p class="eyebrow mb-3">Preguntas frecuentes</p>
      <h2 class="text-[1.7rem] sm:text-3xl md:text-4xl font-display font-semibold">
        Lo que suelen consultarnos
      </h2>
    </div>

    <div class="divide-y divide-line border-y border-line">
      {faqs.map((faq) => (
        <details class="group" data-reveal>
          <summary class="flex items-center justify-between gap-3 sm:gap-4 cursor-pointer py-5 list-none">
            <span class="font-display text-base sm:text-lg font-medium text-ink">{faq.q}</span>
            <span class="shrink-0 w-7 h-7 rounded-full border border-line flex items-center justify-center text-brand-500 transition-transform duration-200 group-open:rotate-45">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
            </span>
          </summary>
          <p class="text-ink-soft leading-relaxed pb-5 pr-2 sm:pr-10">{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
