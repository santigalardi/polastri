---
const navItems = [
  { href: '/#areas', label: 'Áreas' },
  { href: '/#sucesiones', label: 'Financiamiento' },
  { href: '/#sobre-mi', label: 'Sobre mí' },
  { href: '/#faq', label: 'Preguntas' },
  { href: '/#contacto', label: 'Contacto' },
];
---

<header class="sticky top-0 z-40 bg-cream/95 backdrop-blur border-b border-line">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 h-18 md:h-20 flex items-center justify-between gap-3">
    <a href="/" class="flex items-center gap-2.5 sm:gap-3 group min-w-0" aria-label="Inicio — Abogada Polastri">
      <img
        src="/logo-nobg.png"
        alt=""
        class="h-12 sm:h-14 md:h-16 w-auto shrink-0 transition-transform duration-200 group-hover:scale-105"
        width="514"
        height="363"
      />
      <span class="flex flex-col leading-none border-l border-line pl-2.5 sm:pl-3 min-w-0">
        <span class="font-display text-base sm:text-lg font-semibold text-brand-700 tracking-tight truncate">
          María Laura Polastri
        </span>
        <span class="font-display text-[0.72rem] sm:text-[0.8rem] uppercase tracking-[0.22em] sm:tracking-[0.26em] text-mauve-500 mt-1 truncate">
          Abogada
        </span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-8">
      {navItems.map((item) => (
        <a href={item.href} class="nav-link">{item.label}</a>
      ))}
    </nav>

    <button
      id="mobile-menu-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="md:hidden shrink-0 -mr-2 p-2 text-brand-700"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>
</header>

<!-- Menú móvil: FUERA del header para no quedar atrapado en su stacking context -->
<div id="mobile-menu" class="md:hidden">
  <!-- Overlay oscuro -->
  <div
    id="mobile-menu-overlay"
    class="fixed inset-0 z-50 bg-ink/50 opacity-0 pointer-events-none transition-opacity duration-300"
  >
  </div>

  <!-- Panel deslizante -->
  <aside
    id="mobile-menu-panel"
    class="fixed top-0 right-0 z-50 h-dvh w-[82%] max-w-xs bg-brand-700 text-cream shadow-2xl translate-x-full transition-transform duration-300 ease-out flex flex-col"
    aria-hidden="true"
  >
    <div class="flex items-center justify-between px-6 h-18 border-b border-cream/15">
      <span class="font-display text-base font-semibold text-cream">María Laura Polastri</span>
      <button id="mobile-menu-close" aria-label="Cerrar menú" class="-mr-2 p-2 text-cream">
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <nav class="flex flex-col px-3 py-4">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="font-display text-lg text-cream py-3.5 px-3 rounded-[var(--radius-card)] hover:bg-cream/10 transition-colors"
          data-mobile-link
        >
          {item.label}
        </a>
      ))}
    </nav>

  </aside>
</div>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('mobile-menu-close');
  const overlay = document.getElementById('mobile-menu-overlay');
  const panel = document.getElementById('mobile-menu-panel');

  const open = () => {
    overlay?.classList.remove('opacity-0', 'pointer-events-none');
    panel?.classList.remove('translate-x-full');
    panel?.setAttribute('aria-hidden', 'false');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };

  const close = () => {
    overlay?.classList.add('opacity-0', 'pointer-events-none');
    panel?.classList.add('translate-x-full');
    panel?.setAttribute('aria-hidden', 'true');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };

  toggle?.addEventListener('click', open);
  closeBtn?.addEventListener('click', close);
  overlay?.addEventListener('click', close);
  document.querySelectorAll('[data-mobile-link]').forEach((link) => {
    link.addEventListener('click', close);
  });
  // Cerrar con tecla Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });
</script>
