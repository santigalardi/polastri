---
const year = new Date().getFullYear();
---

<footer class="bg-accent text-primary">
  <div class="max-w-6xl mx-auto px-6 py-12 grid gap-8 md:grid-cols-3">
    <div>
      <h3 class="font-serif text-xl mb-3 text-primary">Estudio Jurídico</h3>
      <p class="text-sm text-slate-300">
        Asesoramiento legal integral con compromiso, ética y resultados.
      </p>
    </div>

    <div>
      <h4 class="font-serif text-lg mb-3 text-primary">Enlaces</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="/" class="hover:text-white transition-colors text-slate-300">Inicio</a></li>
        <li><a href="/privacidad" class="hover:text-white transition-colors text-slate-300">Política de privacidad</a></li>
        <li><a href="/terminos" class="hover:text-white transition-colors text-slate-300">Términos y condiciones</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-serif text-lg mb-3 text-primary">Contacto</h4>
      <ul class="space-y-2 text-sm text-slate-300">
        <li>contacto@estudio.com</li>
        <li>+54 11 0000-0000</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-6xl mx-auto px-6 py-4 text-xs text-slate-400 text-center">
      © {year} Estudio Jurídico. Todos los derechos reservados.
    </div>
  </div>
</footer>
